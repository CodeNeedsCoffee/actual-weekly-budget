#!/usr/bin/env bash
# Blocks commits that look like they contain personal or secret data.
# Add private patterns (names, hosts, ids) to .git/private-patterns (untracked), one regex per line.
set -u
root=$(git rev-parse --show-toplevel)
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
bad_names=$(echo "$files" | grep -E '(^|/)\.env($|\.)|\.(sqlite|db|pem|key|jks|keystore)$|backup|fixtures/private/|(^|/)private/' | grep -v '\.env\.example')
if [ -n "$bad_names" ]; then echo "pre-commit: blocked file names:"; echo "$bad_names"; fail=1; fi
added=$(git diff --cached -U0 --no-color -- . ':!tools/hooks/pre-commit' | grep -E '^\+[^+]')
generic='([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{2,5}|192\.168\.[0-9]+\.[0-9]+|10\.[0-9]+\.[0-9]+\.[0-9]+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{6,}|op://|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}'
hits=$(echo "$added" | grep -E -i "$generic" | grep -v -E 'example\.(com|org)|noreply@')
if [ -n "$hits" ]; then echo "pre-commit: possible secret/host/id/email in added lines:"; echo "$hits" | head -20; fail=1; fi
if [ -f "$root/.git/private-patterns" ]; then
  while IFS= read -r p; do [ -z "$p" ] && continue
    h=$(echo "$added" | grep -E -i -- "$p"); [ -n "$h" ] && { echo "pre-commit: matches private pattern '$p':"; echo "$h" | head -5; fail=1; }
  done < "$root/.git/private-patterns"
fi
[ $fail -ne 0 ] && echo "Commit blocked. Fix it, or review and use --no-verify only if sure." && exit 1
exit 0
