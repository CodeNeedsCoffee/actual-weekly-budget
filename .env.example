# Copy to bridge/.env (git-ignored) and fill in. Never commit real values.
BRIDGE_TOKEN=change-me
ACTUAL_URL=http://actual-server:5006
ACTUAL_PASSWORD=change-me
ACTUAL_BUDGET_ID=change-me
# Optional: JSON file with split rules (see bridge/split-rules.example.json); keep your real one out of git.
SPLIT_RULES_FILE=
FORECAST_CONFIG_FILE=
# Required when the bridge is reachable from the internet: at least 32 random characters (openssl rand -hex 24).
# The bridge refuses to start with a shorter token.
# CLIENT_IP_HEADER is set in compose.yaml; leave it unset anywhere the bridge is reachable without Cloudflare in front.
